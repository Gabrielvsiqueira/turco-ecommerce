{
  "info": {
    "name": "E-commerce (protocolo 1.3.1)",
    "description": "Rotas da 1ª entrega. Troque a variável baseUrl para testar o servidor de um colega (ex.: http://192.168.0.50:8080/api/v1). Faça o login antes das rotas com token: ele salva token, sessionId e userId sozinho.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Cadastrar usuário",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Gabriel Siqueira\",\n  \"email\": \"gabriel@teste.com\",\n  \"senha\": \"senha123\"\n}"
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('userId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"gabriel@teste.com\",\n  \"senha\": \"senha123\"\n}"
        },
        "url": "{{baseUrl}}/sessions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('token', body.token);",
              "  pm.collectionVariables.set('sessionId', body.id);",
              "  pm.collectionVariables.set('userId', body.usuario.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Ver usuário",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/{{userId}}"
      }
    },
    {
      "name": "4. Atualizar usuário (PUT, todos os campos)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Gabriel Siqueira\",\n  \"email\": \"gabriel@teste.com\",\n  \"senha\": \"senha123\"\n}"
        },
        "url": "{{baseUrl}}/users/{{userId}}"
      }
    },
    {
      "name": "5. Atualizar usuário (PATCH, só o que mudar)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Gabriel S.\"\n}"
        },
        "url": "{{baseUrl}}/users/{{userId}}"
      }
    },
    {
      "name": "6. Logout",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/sessions/{{sessionId}}"
      }
    },
    {
      "name": "7. Excluir usuário",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/users/{{userId}}"
      }
    }
  ]
}
