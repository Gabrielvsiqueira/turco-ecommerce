# Arquivo do SQLite, relativo a prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Regra 1: IP e porta ficam a critério de quem sobe o servidor. 8080 é o default do YAML.
HOST=0.0.0.0
PORT=8080

# ADM criado por `npm run db:seed` (cria, ou promove se o e-mail já existir).
# Mesmas regras da API: e-mail de 5 a 30 caracteres; senha de 6 a 20, só letras e números.
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@loja.com"
ADMIN_SENHA="admin123"

# Painel de usuários logados no console. "off" volta para o log em linhas
# (o painel limpa a tela a cada evento; use "off" para ver stack de erros).
PAINEL=on
